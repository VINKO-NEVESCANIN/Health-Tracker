// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int           @id @default(autoincrement())
  name        String
  email       String        @unique
  password    String
  role        String        // "doctor" | "patient" | "admin"
  createdAt   DateTime      @default(now())

  patients    Patient[]     @relation("DoctorPatients")
  appointments Appointment[] // citas como doctor
}

model Patient {
  id          Int       @id @default(autoincrement())
  nombre      String
  apellido    String?
  tipoEpilepsia String?
  primeraCrisis DateTime?
  totalCrisis  Int       @default(0)
  enfermedades String?
  edad        Int?
  telefono    String?
  direccion   String?
  email       String?   @unique
  createdAt   DateTime  @default(now())

  doctorId    Int
  doctor      User      @relation("DoctorPatients", fields: [doctorId], references: [id])

  appointments Appointment[]
  medications  PatientMedication[]
  studies      Study[]
  vitals       Vital[]
  crisis       Crisis[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  patientId Int
  doctorId  Int
  fecha     DateTime
  notas     String?
  status    String   @default("scheduled") // scheduled|cancelled|done

  patient   Patient  @relation(fields: [patientId], references: [id])
  doctor    User     @relation(fields: [doctorId], references: [id])
}

model Medication {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  createdAt   DateTime @default(now())

  patients    PatientMedication[]
}

model PatientMedication {
  id           Int      @id @default(autoincrement())
  patientId    Int
  medicationId Int
  dosis        String?
  intervalo    String?
  startDate    DateTime?
  endDate      DateTime?

  patient      Patient    @relation(fields: [patientId], references: [id])
  medication   Medication @relation(fields: [medicationId], references: [id])
}

model Study {
  id        Int      @id @default(autoincrement())
  patientId Int
  tipo      String
  fecha     DateTime @default(now())
  notas     String?
  fileUrl   String?  // si subes pdf / imagen

  patient   Patient @relation(fields: [patientId], references: [id])
}

model Vital {
  id        Int      @id @default(autoincrement())
  patientId Int
  fecha     DateTime @default(now())
  heartRate Int?
  oxygen    Int?
  temp      Float?
  notes     String?

  patient   Patient @relation(fields: [patientId], references: [id])
}

model Crisis {
  id        Int      @id @default(autoincrement())
  patientId Int
  fecha     DateTime @default(now())
  intensidad Int?
  duracionMin Int?
  notas     String?

  patient   Patient @relation(fields: [patientId], references: [id])
}

