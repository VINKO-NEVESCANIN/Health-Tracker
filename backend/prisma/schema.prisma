// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


//
// USERS
//
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String // "doctor" | "admin"
  createdAt DateTime @default(now())

  patients     Patient[]     @relation("DoctorPatients")
  appointments Appointment[]
}

//
// PATIENT
//
model Patient {
  id              Int       @id @default(autoincrement())
  firstName       String
  lastName        String?
  epilepsyType    String?
  firstCrisisDate DateTime?
  totalCrisis     Int       @default(0)
  diseases        String?
  age             Int?
  phone           String?
  address         String?
  email           String?   @unique
  createdAt       DateTime  @default(now())

  doctorId Int
  doctor   User @relation("DoctorPatients", fields: [doctorId], references: [id])

  appointments Appointment[]
  medications  PatientMedication[]
  studies      Study[]
  vitals       Vital[]
  crisis       Crisis[]
}

//
// APPOINTMENT
//
model Appointment {
  id        Int      @id @default(autoincrement())
  patientId Int
  doctorId  Int
  date      DateTime
  notes     String?
  status    String   @default("scheduled") // scheduled | cancelled | done

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  User    @relation(fields: [doctorId], references: [id])
}

//
// MEDICATIONS
//
model Medication {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())

  patients PatientMedication[]
}

model PatientMedication {
  id           Int       @id @default(autoincrement())
  patientId    Int
  medicationId Int
  dose         String?
  interval     String?
  startDate    DateTime?
  endDate      DateTime?

  patient    Patient    @relation(fields: [patientId], references: [id])
  medication Medication @relation(fields: [medicationId], references: [id])
}

//
// STUDIES (PDFs, images, CT scans, EEG…)
//
model Study {
  id        Int      @id @default(autoincrement())
  patientId Int
  type      String
  date      DateTime @default(now())
  notes     String?
  fileUrl   String?

  patient Patient @relation(fields: [patientId], references: [id])
}

//
// VITALS
//
model Vital {
  id          Int      @id @default(autoincrement())
  patientId   Int
  date        DateTime @default(now())
  heartRate   Int?
  oxygen      Int?
  temperature Float?
  notes       String?

  patient Patient @relation(fields: [patientId], references: [id])
}

//
// CRISIS EVENTS
//
model Crisis {
  id          Int      @id @default(autoincrement())
  patientId   Int
  date        DateTime @default(now())
  intensity   Int?
  durationMin Int?
  notes       String?

  patient Patient @relation(fields: [patientId], references: [id])
}
