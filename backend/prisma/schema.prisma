datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  role         String
  appointments Appointment[]
  patients     Patient[]     @relation("DoctorPatients")
}

model Patient {
  id              Int                 @id @default(autoincrement())
  doctorId        Int?
  gender          String?
  age             Int?
  height          String?
  weight          String?
  birthdate       DateTime?
  epilepsyType    String?
  firstCrisisDate DateTime?
  firstName       String?
  lastName        String?
  anxiety          Boolean?
  migraine         Boolean?
  addictions       Boolean?
  hypertension     Boolean?
  cogniDisorder    Boolean?
  respiDisorder    Boolean?	  
  appointments    Appointment[]
  crisis          Crisis[]
  doctor          User?                @relation("DoctorPatients", fields: [doctorId], references: [id])
  medications     PatientMedication[]
  studies         Study[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  patientId Int
  doctorId  Int
  date      DateTime
  time      String
  notes     String?
  status    String   @default("scheduled")
  doctor    User     @relation(fields: [doctorId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Medication {
  id          Int                 @id @default(autoincrement())
  type        String
  name        String
  abbreviation String
  patients    PatientMedication[]
}

model PatientMedication {
  id           Int        @id @default(autoincrement())
  patientId    Int
  medicationId Int
  name         String?
  dose         String?
  interval     String?
  startDate    DateTime?
  patient      Patient    @relation(fields: [patientId], references: [id])
  medication   Medication @relation(fields: [medicationId], references: [id])
}

model Study {
  id        Int      @id @default(autoincrement())
  patientId Int
  dateEEG   DateTime?
  dateRMNC  DateTime?
  dateNSMAP DateTime?	
  resEEG    String?
  resRMNC   String?
  resNSMAP  String?
  patient   Patient  @relation(fields: [patientId], references: [id])
}


model Crisis {
  id          Int      @id @default(autoincrement())
  patientId   Int
  crisisDate  DateTime
  duration    Int?
  recuperation   Int?
  unconscius  Boolean?
  patient     Patient  @relation(fields: [patientId], references: [id])
}
