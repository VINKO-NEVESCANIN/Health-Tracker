datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}


generator client {
  provider = "prisma-client-js"
}


model User {
  id              Int           @id @default(autoincrement())
  doctorId        Int?
  firstName       String?
  lastName        String?
  email           String        @unique
  password        String
  firstTime       Boolean      @default(true)
  role            String
  gender          String?
  age             Int?
  height          String?
  weight          String?
  birthdate       DateTime?
  epilepsyType    String?
  firstCrisisDate DateTime?
  anxiety         Boolean?
  migraine        Boolean?
  addictions      Boolean?
  hypertension    Boolean?
  cogniDisorder   Boolean?
  respiDisorder   Boolean?	  
  crisis          Crisis[]
  medications     PatientMedication[]
  studies         Study[]
  appointments    Appointment[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  patientId Int
  doctorId  Int
  date      DateTime
  time      String
  notes     String?
  status    String   @default("scheduled")
  doctor    User     @relation(fields: [doctorId], references: [id])

}

model Medication {
  id          Int                 @id @default(autoincrement())
  type        String
  name        String
  abbreviation String
  patients    PatientMedication[]
}

model PatientMedication {
  id           Int        @id @default(autoincrement())
  patientId    Int
  medicationId Int
  name         String?
  dose         String?
  interval     String?
  startDate    DateTime?
  patient      User    @relation(fields: [patientId], references: [id])
  medication   Medication @relation(fields: [medicationId], references: [id])
}

model Study {
  id        Int      @id @default(autoincrement())
  patientId Int
  dateEEG   DateTime?
  dateRMNC  DateTime?
  dateNSMAP DateTime?	
  resEEG    String?
  resRMNC   String?
  resNSMAP  String?
  patient   User  @relation(fields: [patientId], references: [id])
}


model Crisis {
  id          Int      @id @default(autoincrement())
  patientId   Int
  crisisDate  DateTime
  duration    Int?
  recuperation   Int? 
  unconscius  Boolean?
  patient     User  @relation(fields: [patientId], references: [id])
}