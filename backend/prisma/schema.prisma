generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int                 @id @default(autoincrement())
  email           String              @unique
  password        String
  role            String
  addictions      Boolean?
  age             Int?
  anxiety         Boolean?
  birthdate       DateTime?
  cogniDisorder   Boolean?
  doctorId        Int?
  epilepsyType    String?
  firstCrisisDate DateTime?
  firstName       String?
  firstTime       Boolean             @default(true)
  gender          String?
  height          String?
  hypertension    Boolean?
  lastName        String?
  migraine        Boolean?
  respiDisorder   Boolean?
  weight          String?
  appointments    Appointment[]
  crisis          Crisis[]
  medications     PatientMedication[]
  studies         Study[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  patientId Int
  doctorId  Int
  date      DateTime
  notes     String?
  status    String   @default("scheduled")
  time      String
  doctor    User     @relation(fields: [doctorId], references: [id])
}

model Medication {
  id           Int                 @id @default(autoincrement())
  name         String
  type         String
  abbreviation String
  patients     PatientMedication[]
}

model PatientMedication {
  id           Int        @id @default(autoincrement())
  patientId    Int
  medicationId Int
  dose         String?
  interval     String?
  presentation String?
  abbreviation String?
  name         String?
  medication   Medication @relation(fields: [medicationId], references: [id])
  patient      User       @relation(fields: [patientId], references: [id])
}

model Study {
  id        Int       @id @default(autoincrement())
  patientId Int
  dateEEG   DateTime? @default(now())
  dateNSMAP DateTime? @default(now())
  dateRMNC  DateTime? @default(now())
  resEEG    String?   @default("No Realizado")
  resNSMAP  String?   @default("No Realizado")
  resRMNC   String?   @default("No Realizado")
  patient   User      @relation(fields: [patientId], references: [id])
}

model Crisis {
  id           Int      @id @default(autoincrement())
  patientId    Int
  crisisDate   DateTime
  duration     Int?
  recuperation Int?
  unconscius   Boolean?
  medication   String?
  patient      User     @relation(fields: [patientId], references: [id])
}
