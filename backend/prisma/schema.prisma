generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  role         String
  appointments Appointment[]
  patients     Patient[]     @relation("DoctorPatients")
}

model Patient {
  id              Int                 @id @default(autoincrement())
  email           String?             @unique
  createdAt       DateTime            @default(now())
  doctorId        Int
  address         String?
  age             Int?
  diseases        String?
  epilepsyType    String?
  firstCrisisDate DateTime?
  firstName       String
  lastName        String?
  phone           String?
  totalCrisis     Int                 @default(0)
  appointments    Appointment[]
  crisis          Crisis[]
  doctor          User                @relation("DoctorPatients", fields: [doctorId], references: [id])
  medications     PatientMedication[]
  studies         Study[]
  vitals          Vital[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  patientId Int
  doctorId  Int
  date      DateTime
  notes     String?
  status    String   @default("scheduled")
  doctor    User     @relation(fields: [doctorId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Medication {
  id          Int                 @id @default(autoincrement())
  createdAt   DateTime            @default(now())
  description String?
  name        String
  patients    PatientMedication[]
}

model PatientMedication {
  id           Int        @id @default(autoincrement())
  patientId    Int
  medicationId Int
  dose         String?
  endDate      DateTime?
  interval     String?
  startDate    DateTime?
  medication   Medication @relation(fields: [medicationId], references: [id])
  patient      Patient    @relation(fields: [patientId], references: [id])
}

model Study {
  id        Int      @id @default(autoincrement())
  patientId Int
  date      DateTime @default(now())
  fileUrl   String?
  notes     String?
  type      String
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Vital {
  id          Int      @id @default(autoincrement())
  patientId   Int
  heartRate   Int?
  oxygen      Int?
  date        DateTime @default(now())
  notes       String?
  temperature Float?
  patient     Patient  @relation(fields: [patientId], references: [id])
}

model Crisis {
  id          Int      @id @default(autoincrement())
  patientId   Int
  date        DateTime @default(now())
  durationMin Int?
  intensity   Int?
  notes       String?
  patient     Patient  @relation(fields: [patientId], references: [id])
}
