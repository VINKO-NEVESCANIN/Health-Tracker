# Copia este archivo a .env y completa los valores. NUNCA subas .env a GitHub.

# Cadena de conexión a PostgreSQL
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/health_tracker?schema=public"

# Secreto para firmar los tokens. Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=4000

# Producción: NODE_ENV=production. Orígenes web permitidos (la app móvil no los necesita).
# NODE_ENV=production
# CORS_ORIGIN=https://tu-dominio.com

# Solo desarrollo: permite crear Doctor/Admin desde /auth/register (ignorado en producción)
# ALLOW_ROLE_SIGNUP=true
